<% layout("/layouts/boilerplate") %>

    <!-- <h3 >All listings</h3> -->
    <!-- <form action="/listings/new" method="GET">
        <button>Create New Listing</button>
    </form> -->
    <div id="filters">
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-fire"></i></div>
            <p class="filt-name">Trending</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-bed"></i></div>
            <p class="filt-name">Rooms</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-mountain-sun"></i></i></div>
            <p class="filt-name">Mountains</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-city"></i></i></i></div>
            <p class="filt-name">Iconic Cities</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-umbrella-beach"></i></i></i></div>
            <p class="filt-name">Beach</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-brands fa-fort-awesome"></i></i></i></div>
            <p class="filt-name">Forts</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-person-swimming"></i></i></i></i></div>
            <p class="filt-name">Swimming</p>
            
        </div>
         <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-umbrella-beach"></i></i></i></div>
            <p class="filt-name">Camping</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-brands fa-fort-awesome"></i></i></i></div>
            <p class="filt-name">Farms</p>
            
        </div>
        <div class="filter">
            <div class="filt-icon"><i class="fa-solid fa-person-swimming"></i></i></i></i></div>
            <p class="filt-name">Cruse</p>
            
        </div>
    </div>

    <div class="row row-cols-lg-4  row-cols-md-2 row-cols-sm-1"> 
        <% allListings.forEach(element => { %>
            <a id="nev" href="/listings/<%= element._id %>">
                <div class="card listing-card col">
                    <img src="<%= element.image.url%>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text"><b><%= element.title%></b> <br>
                        ₹ <%= element.price.toLocaleString("en-IN") %>
                        </p>

                    </div>
                </div>
            </a>
        <% }) %>
    </div>

    



