<% layout("/layouts/boilerplate") %>

    <!-- Search Section between Navbar and Filters -->
    <div class="search-bar-container">
      <form action="/listings" method="GET" class="search-bar-form">
        <div class="search-field">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
          <input 
            type="text" 
            name="q" 
            class="search-input-field" 
            placeholder="Search any destination, city, country, or category..." 
            value="<%= typeof q !== 'undefined' ? q : '' %>"
            autocomplete="off"
          >
        </div>
        <button type="submit" class="search-submit-btn">
          Search
        </button>
      </form>
    </div>

    <div id="filters">
        <a href="<%= typeof category !== 'undefined' && category === 'Trending' ? '/listings' : '/listings?category=Trending' %>" class="filter <%= typeof category !== 'undefined' && category === 'Trending' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-fire"></i></div>
            <p class="filt-name">Trending</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Rooms' ? '/listings' : '/listings?category=Rooms' %>" class="filter <%= typeof category !== 'undefined' && category === 'Rooms' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-bed"></i></div>
            <p class="filt-name">Rooms</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Mountains' ? '/listings' : '/listings?category=Mountains' %>" class="filter <%= typeof category !== 'undefined' && category === 'Mountains' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-mountain-sun"></i></div>
            <p class="filt-name">Mountains</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Iconic Cities' ? '/listings' : '/listings?category=Iconic Cities' %>" class="filter <%= typeof category !== 'undefined' && category === 'Iconic Cities' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-city"></i></div>
            <p class="filt-name">Iconic Cities</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Beach' ? '/listings' : '/listings?category=Beach' %>" class="filter <%= typeof category !== 'undefined' && category === 'Beach' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-umbrella-beach"></i></div>
            <p class="filt-name">Beach</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Forts' ? '/listings' : '/listings?category=Forts' %>" class="filter <%= typeof category !== 'undefined' && category === 'Forts' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-brands fa-fort-awesome"></i></div>
            <p class="filt-name">Forts</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Swimming' ? '/listings' : '/listings?category=Swimming' %>" class="filter <%= typeof category !== 'undefined' && category === 'Swimming' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-person-swimming"></i></div>
            <p class="filt-name">Swimming</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Camping' ? '/listings' : '/listings?category=Camping' %>" class="filter <%= typeof category !== 'undefined' && category === 'Camping' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-campground"></i></div>
            <p class="filt-name">Camping</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Farms' ? '/listings' : '/listings?category=Farms' %>" class="filter <%= typeof category !== 'undefined' && category === 'Farms' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-cow"></i></div>
            <p class="filt-name">Farms</p>
        </a>
        <a href="<%= typeof category !== 'undefined' && category === 'Cruse' ? '/listings' : '/listings?category=Cruse' %>" class="filter <%= typeof category !== 'undefined' && category === 'Cruse' ? 'active' : '' %>">
            <div class="filt-icon"><i class="fa-solid fa-ship"></i></div>
            <p class="filt-name">Cruse</p>
        </a>
    </div>

    <% if (typeof q !== 'undefined' && q) { %>
        <div class="d-flex align-items-center justify-content-between mb-3 mt-2">
            <p class="mb-0 text-muted">Showing search results for <strong>"<%= q %>"</strong> (<%= allListings.length %> listings found)</p>
            <a href="/listings" class="btn btn-sm btn-outline-secondary">Clear Search</a>
        </div>
    <% } else if (typeof category !== 'undefined' && category) { %>
        <div class="d-flex align-items-center justify-content-between mb-3 mt-2">
            <p class="mb-0 text-muted">Showing results for <strong>"<%= category %>"</strong> (<%= allListings.length %> listings found)</p>
            <a href="/listings" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
        </div>
    <% } %>

    <% if (allListings.length === 0) { %>
        <div class="col-12 text-center my-5 py-4">
            <h4 class="text-muted">No destinations found matching "<%= typeof q !== 'undefined' && q ? q : category %>"</h4>
            <a href="/listings" class="btn btn-danger mt-3 px-4">View All Listings</a>
        </div>
    <% } else { %>
        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1"> 
            <% allListings.forEach(element => { %>
                <a id="nev" href="/listings/<%= element._id %>">
                    <div class="card listing-card col position-relative">
                        <div class="position-relative">
                            <img src="<%= element.image.url%>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
                            <button type="button" class="like-badge-btn <%= typeof userWatchlist !== 'undefined' && userWatchlist.includes(element._id.toString()) ? 'liked' : '' %>" onclick="toggleLike(event, '<%= element._id %>')" title="Save to Watchlist">
                                <i class="<%= typeof userWatchlist !== 'undefined' && userWatchlist.includes(element._id.toString()) ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                            </button>
                        </div>
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text"><b><%= element.title%></b> <br>
                            ₹ <%= element.price.toLocaleString("en-IN") %>
                            </p>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>

    



