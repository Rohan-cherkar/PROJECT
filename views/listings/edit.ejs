<% layout("/layouts/boilerplate") %>

<h3 class="h3-heading">Edit Your Listing</h3>
<form action="/listings/<%= listing.id%>?_method=PATCH" method="POST">
  <label for="listing[title]">Title</label>
  <input
    type="text"
    name="listing[title]"
    placeholder="Enter Title"
    value="<%= listing.title %>"
  />
  <br />
  <br />
  <label for="listing[description]">Descripton</label>
  <textarea
    type="text"
    name="listing[description]"
    placeholder="Enter Descripton"
  >
<%= listing.description %>"</textarea
  ><br />
  <br />
  <label for="listing[image.url]">Image Link</label>
  <input
    type="text"
    name="listing[image.url]"
    value="<%= listing.image.url %>"
  />
  <br /><br />
  <label for="listing[price]">Price</label>
  <input type="number" name="listing[price]" value="<%= listing.price %>" />
  <br /><br />
  <label for="listing[location]">Location</label>
  <input type="text" name="listing[location]" value="<%= listing.location %>" />
  <br /><br />
  <label for="listing[country]">Country</label>
  <input type="text" name="listing[country]" value="<%= listing.country %>" />
  <br /><br />
  <button>Edit</button>
</form>
