<% layout("/layouts/boilerplate") %>

<h3 class="h3-heading">Edit Your Listing</h3>
<form
  action="/listings/<%= listing.id%>?_method=put"
  method="POST"
  novalidate
  class="needs-validation"
  enctype="multipart/form-data"
>
  <label for="listing[title]" class="form-label">Title</label>
  <input
    type="text"
    name="listing[title]"
    placeholder="Enter Title"
    value="<%= listing.title %>"
    class="form-control"
    required
  />

  <label for="listing[description]">Descripton</label>
  <textarea
    type="text"
    name="listing[description]"
    placeholder="Enter Descripton"
    class="form-control"
    required
  ><%= listing.description %></textarea>

  <div class="mb-3"><p>Original Listing Image</p><img style="height: 100px;width: 180px; " src="<%= originalImg %>" alt=""></div>
  <label for="listing[image]">Image Link</label>
  <input
    type="file"
    name="listing[image]"
    class="form-control"
  />

  <label for="listing[price]">Price</label>
  <input
    type="number"
    name="listing[price]"
    required
    value="<%= listing.price %>"
    class="form-control"
  />

  <label for="listing[location]">Location</label>
  <input
    type="text"
    name="listing[location]"
    required
    value="<%= listing.location %>"
    class="form-control"
  />

  <label for="listing[country]">Country</label>
  <input
    type="text"
    name="listing[country]"
    required
    value="<%= listing.country %>"
    class="form-control"
  />

  <button>Edit</button>
</form>
