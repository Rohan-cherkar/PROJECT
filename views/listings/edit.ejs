<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Romely</title>
  </head>
  <body>
    <h3>Edit Your Listing</h3>
    <form action="/listings/<%= listing.id%>?_method=PATCH" method="POST">
      <input
        type="text"
        name="listing[title]"
        placeholder="Enter Title"
        value="<%= listing.title %>"
      />
      <br />
      <br />
      <textarea
        type="text"
        name="listing[description]"
        placeholder="Enter Descripton"
      >
<%= listing.description %>"</textarea
      ><br />
      <br />
      <input type="text" name="listing[image]" value="<%= listing.image.url %>" />
      <br /><br />
      <input type="number" name="listing[price]" value="<%= listing.price %>" />
      <br /><br />
      <input
        type="text"
        name="listing[location]"
        value="<%= listing.location %>"
      />
      <br /><br />
      <input
        type="text"
        name="listing[country]"
        value="<%= listing.country %>"
      />
      <br /><br />
      <button>Edit</button>
    </form>
  </body>
</html>
