<% layout("/layouts/boilerplate") %>

<h3 class="h3-heading">Edit Your Listing</h3>
<form
  action="/listings/<%= listing.id%>?_method=put"
  method="POST"
  novalidate
  class="needs-validation"
  enctype="multipart/form-data"
>
  <label for="listing[title]" class="form-label">Title</label>
  <input
    type="text"
    name="listing[title]"
    placeholder="Enter Title"
    value="<%= listing.title %>"
    class="form-control"
    required
  />

  <label for="listing[description]">Descripton</label>
  <textarea
    type="text"
    name="listing[description]"
    placeholder="Enter Descripton"
    class="form-control"
    required
  ><%= listing.description %></textarea>

  <div class="mb-3"><p>Original Listing Image</p><img style="height: 100px;width: 180px; " src="<%= originalImg %>" alt=""></div>
  <label for="listing[image]">Image Link</label>
  <input
    type="file"
    name="listing[image]"
    class="form-control"
  />

  <label for="listing[price]">Price</label>
  <input
    type="number"
    name="listing[price]"
    required
    value="<%= listing.price %>"
    class="form-control"
  />

  <label for="listing[location]">Location</label>
  <input
    type="text"
    name="listing[location]"
    required
    value="<%= listing.location %>"
    class="form-control"
  />

  <label for="listing[country]">Country</label>
  <input
    type="text"
    name="listing[country]"
    required
    value="<%= listing.country %>"
    class="form-control"
  />

  <label for="listing[category]" class="form-label">Category</label>
  <select name="listing[category]" class="form-select mb-3">
    <option value="">Select Category</option>
    <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>Trending</option>
    <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>Rooms</option>
    <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>Mountains</option>
    <option value="Iconic Cities" <%= listing.category === 'Iconic Cities' ? 'selected' : '' %>>Iconic Cities</option>
    <option value="Beach" <%= listing.category === 'Beach' ? 'selected' : '' %>>Beach</option>
    <option value="Forts" <%= listing.category === 'Forts' ? 'selected' : '' %>>Forts</option>
    <option value="Swimming" <%= listing.category === 'Swimming' ? 'selected' : '' %>>Swimming</option>
    <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>Camping</option>
    <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>Farms</option>
    <option value="Cruse" <%= listing.category === 'Cruse' ? 'selected' : '' %>>Cruse</option>
  </select>

  <button>Edit</button>
</form>
