<% layout("/layouts/boilerplate") %>

<div class="mt-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h3 class="fw-bold"><i class="fa-solid fa-house-user text-danger me-2"></i>My Hosted Listings</h3>
        <p class="text-muted mb-0">Listings you have created and host on Roamly.</p>
    </div>
    <a href="/listings/new" class="btn btn-danger px-3 py-2 rounded-3"><i class="fa-solid fa-plus me-1"></i> Add New Listing</a>
</div>

<% if (!hostedListings || hostedListings.length === 0) { %>
    <div class="col-12 text-center my-5 py-5 bg-white rounded-4 border">
        <i class="fa-solid fa-house-circle-exclamation display-1 text-secondary opacity-50 mb-3"></i>
        <h4 class="text-dark fw-semibold">You haven't created any listings yet</h4>
        <p class="text-muted">Start hosting by adding your first property or destination on Roamly!</p>
        <a href="/listings/new" class="btn btn-danger px-4 mt-2 rounded-3">Add Your First Listing</a>
    </div>
<% } else { %>
    <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1"> 
        <% hostedListings.forEach(element => { %>
            <a id="nev" href="/listings/<%= element._id %>">
                <div class="card listing-card col position-relative">
                    <div class="position-relative">
                        <img src="<%= element.image.url%>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
                        <button type="button" class="like-badge-btn <%= typeof userWatchlist !== 'undefined' && userWatchlist.includes(element._id.toString()) ? 'liked' : '' %>" onclick="toggleLike(event, '<%= element._id %>')" title="Save to Watchlist">
                            <i class="<%= typeof userWatchlist !== 'undefined' && userWatchlist.includes(element._id.toString()) ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                        </button>
                    </div>
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text"><b><%= element.title%></b> <br>
                        ₹ <%= element.price.toLocaleString("en-IN") %>
                        </p>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>
<% } %>
