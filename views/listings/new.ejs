<% layout("/layouts/boilerplate") %>
<body>
  <h3 class="h3-heading">Create the new Listing</h3>
  <form
    action="/listings"
    method="POST"
    novalidate
    class="needs-validation"
    enctype="multipart/form-data"
  >
    <div>
      <label for="" class="form-label"> Title</label>
      <input
        type="text"
        name="listing[title]"
        placeholder="Enter Title"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Title must not be Empty.</div>
    </div>
    <div>
      <label for="" class="form-label">Description</label>
      <textarea
        type="text"
        name="listing[description]"
        placeholder="Enter Descripton"
        class="form-control"
        required
      ></textarea>
      <div class="invalid-feedback">Please write short Descripotion.</div>
    </div>
    
    <div>
      <label for="" class="form-label">Upload Image</label>
      <input
        type="file"
        name="listing[image]"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Image URL Required.</div>
    </div>
    <div>
      <label for="" class="form-label">Price</label>
      <input
        type="number"
        name="listing[price]"
        placeholder="Enter Price"
        class="form-control"
        min="0"
        required
      />
      <div class="invalid-feedback">Please enter the Price.</div>
    </div>
    <div>
      <label for="" class="form-label">Location</label>
      <input
        type="text"
        name="listing[location]"
        placeholder="Enter Location"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Please Enter the Location.</div>
    </div>
    <div>
      <label for="" class="form-label">Category</label>
      <select name="listing[category]" class="form-select mb-3">
        <option value="">Select Category</option>
        <option value="Trending">Trending</option>
        <option value="Rooms">Rooms</option>
        <option value="Mountains">Mountains</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Beach">Beach</option>
        <option value="Forts">Forts</option>
        <option value="Swimming">Swimming</option>
        <option value="Camping">Camping</option>
        <option value="Farms">Farms</option>
        <option value="Cruse">Cruse</option>
      </select>
    </div>
    <div>
      <label for="" class="form-label">Country</label>
      <input
        type="text"
        name="listing[country]"
        placeholder="Enter Country"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Please write Country.</div>
    </div>
    <button>Add</button>
  </form>
</body>
