<% if(success && success.length){ %>    
  <div class="alert alert-success col-8 offset-2 alert-dismissible" role="alert">
    <H6><%= success %></H6>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
 <div class="alert alert-danger col-8 offset-2 alert-dismissible" role="alert">
    <H6><%= error %></H6>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>